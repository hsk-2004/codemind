# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# Prisma / Postgres
DATABASE_URL="postgresql://postgres:password@localhost:5432/codemind"

# Local LLM (Ollama)
OLLAMA_BASE_URL="http://localhost:11434"
# Only when Ollama is reached remotely through the gateway in remote-ollama/ (e.g. app on Vercel).
# OLLAMA_API_KEY=""
LLM_PROVIDER="ollama"
LLM_MODEL="qwen2.5-coder:3b-instruct"
LLM_NUM_CTX="3072"

# Local embeddings (Ollama)
EMBEDDING_PROVIDER="ollama"
EMBEDDING_MODEL="nomic-embed-text"

# Vector store
QDRANT_URL="http://localhost:6333"

# GitHub
GITHUB_TOKEN=""

# Optional cloud chat models. When a key is set, that provider's models appear in the
# model picker. Selecting one sends prompts (including repository code) to that provider.
# Embeddings and search always stay local.
GEMINI_API_KEY=""
GROQ_API_KEY=""
# GEMINI_MODEL="gemini-flash-lite-latest"
# GROQ_MODEL="openai/gpt-oss-20b"


# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Docker Compose only: where the app container reaches Ollama.
# Default (unset) = Ollama on the host. Use http://ollama:11434 with `--profile ollama`.
# DOCKER_OLLAMA_BASE_URL="http://ollama:11434"
