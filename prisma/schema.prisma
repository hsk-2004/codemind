generator client {
  provider = "prisma-client-js"
  previewFeatures =["postgresqlExtensions"]
  // native = dev machine, linux-musl = Docker (Alpine), rhel = Vercel functions
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  extensions=[vector]
}

model User{
    id        String        @id @default(cuid())
    createdAt DateTime      @default(now())
    updatedAt DateTime      @updatedAt


    imageUrl  String?
    firstName String?
    lastName  String?

    emailAddress String @unique

    credits Int @default(150)
    UserToProjects UserToProject[]
    questionsAsked Question[]
}


model Project{
  id           String        @id @default(cuid())
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt


  name         String
  githubUrl    String
  deletedAt    DateTime?

  UserToProjects  UserToProject[]
  commits         Commit[]
  sourceCodeEmbeddings SourceCodeEmbedding[] 
  codeChunks      CodeChunk[]
  savedQuestions Question[]

}

model UserToProject{
     id        String        @id @default(cuid())
    createdAt DateTime      @default(now())
    updatedAt DateTime      @updatedAt

    userId     String
    projectId  String

    user User @relation(fields: [userId],references:[id])
    project Project @relation(fields: [projectId],references:[id])
    @@unique([userId,projectId]) 

}

model Question{

id  String   @id @default(cuid())
createdAt  DateTime  @default(now())
updatedAt  DateTime @updatedAt

question String
answer   String

filesReferences  Json?


projectId String

project  Project @relation(fields: [projectId],references:[id])

userId  String

user User @relation(fields:[userId],references:[id])
}


model Commit{

    id          String        @id @default(cuid())
    createdAt   DateTime      @default(now())
    updatedAt   DateTime      @updatedAt


    projectId   String


    project     Project       @relation(fields: [projectId],references:[id])

    commitMessage      String
    commitHash          String
    commitAuthorName     String
    commitAuthorAvatar    String
    commitDate          DateTime
    summary        String
    
    // Breaking changes tracking
    hasBreakingChanges   Boolean     @default(false)
    breakingChangeSeverity String?   // "low", "medium", "high", "critical"
    breakingChangeDetails String?    // Detailed description of breaking changes
    affectedComponents   String?     // JSON array of affected components/APIs
    migrationRequired    Boolean     @default(false)
    migrationSteps       String?     // Steps needed to migrate
}

/// App-wide settings, such as the selected chat model.
model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

/// Live progress and final report for one repository indexing run.
model IndexingJob {
  id              String    @id
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  finishedAt      DateTime?

  userId          String
  projectId       String?
  repoUrl         String
  status          String    // running | completed | failed
  stage           String    // queued | loading | selecting | indexing | commits | done
  currentItem     String?
  error           String?

  filesInRepo     Int       @default(0)
  filesSelected   Int       @default(0)
  filesProcessed  Int       @default(0)
  filesEmbedded   Int       @default(0)
  filesFailed     Int       @default(0)
  commitsFound    Int       @default(0)
  commitsAnalyzed Int       @default(0)
  breakingFound   Int       @default(0)

  stageTimings    Json      @default("{}")
  events          Json      @default("[]")

  @@index([userId, createdAt])
  @@index([projectId, createdAt])
}

/// One row per call to a local model, for the Metrics dashboard.
model LlmCall {
  id               String   @id @default(cuid())
  createdAt        DateTime @default(now())

  projectId        String?
  operation        String   // rag_answer | direct_answer | file_summary | commit_summary | breaking_change | embedding
  provider         String   @default("ollama") // ollama | gemini | groq
  model            String
  success          Boolean
  error            String?

  inputChars       Int
  promptTokens     Int?
  completionTokens Int?

  latencyMs        Int      // wall-clock time measured by CodeMind
  totalDurationMs  Int?     // reported by Ollama
  loadDurationMs   Int?
  promptEvalMs     Int?
  evalMs           Int?
  tokensPerSecond  Float?

  @@index([createdAt])
  @@index([projectId, createdAt])
}

// Function-level chunks: every indexable file split at function and class
// boundaries, each with its own embedding of the code. Used for retrieval in
// large repositories, where only the most important files get an LLM summary.
model CodeChunk {
  id        String @id
  projectId String
  fileName  String
  symbol    String?
  startLine Int
  endLine   Int
  content   String
  embedding Unsupported("vector(768)")?
  project   Project @relation(fields: [projectId], references: [id])

  @@index([projectId])
}

model SourceCodeEmbedding{
  id               String @id @default(cuid())

  summaryEmbedding Unsupported("vector(768)")?
  sourceCode       String
  fileName         String 
  summary          String 
  projectId        String 
  project Project @relation(fields: [projectId],references:[id])
}