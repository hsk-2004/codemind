    {
      "id": 16,
      "type": "table",
      "title": "Recent model calls",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 24,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT \"createdAt\" AS \"time\", operation, model, \"promptTokens\" AS \"tokens in\", \"completionTokens\" AS \"tokens out\",\n  \"tokensPerSecond\" AS \"tok/s\", \"loadDurationMs\" AS \"load ms\", \"promptEvalMs\" AS \"prompt ms\", \"evalMs\" AS \"generate ms\",\n  \"latencyMs\" AS \"total ms\", success\nFROM \"LlmCall\" WHERE $__timeFilter(\"createdAt\") ORDER BY \"createdAt\" DESC LIMIT 100"
        }
      ]
    },
    {
      "id": 17,
      "type": "table",
      "title": "Indexing runs",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 39,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT \"createdAt\" AS \"time\", \"repoUrl\" AS repository, status, \"filesInRepo\" AS \"files in repo\", \"filesSelected\" AS selected,\n  \"filesEmbedded\" AS embedded, \"filesFailed\" AS failed, \"commitsAnalyzed\" AS commits, \"breakingFound\" AS breaking,\n  round(EXTRACT(EPOCH FROM (\"finishedAt\" - \"createdAt\"))::numeric, 1) AS \"duration s\"\nFROM \"IndexingJob\" WHERE $__timeFilter(\"createdAt\") ORDER BY \"createdAt\" DESC LIMIT 50"
        }
      ]
    }
