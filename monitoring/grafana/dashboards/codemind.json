          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT $__timeGroupAlias(\"createdAt\", '1h'), count(*) AS calls\nFROM \"LlmCall\" WHERE $__timeFilter(\"createdAt\") GROUP BY 1 ORDER BY 1"
        }
