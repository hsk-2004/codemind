# Long random secret shared with the hosted app (set the same value as OLLAMA_API_KEY in Vercel).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OLLAMA_API_KEY=""

# Optional: permanent URL via a Cloudflare named tunnel (Zero Trust > Networks > Tunnels).
# Point the tunnel's public hostname at http://gateway:8080.
CLOUDFLARE_TUNNEL_TOKEN=""
